---
import MainLayout from '../layouts/MainLayout.astro';
import ProductList from '../components/ProductList.astro';

const SHOP = import.meta.env.PUBLIC_SHOPIFY_STORE_DOMAIN;
const TOKEN = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN;
const API_VER = import.meta.env.SHOPIFY_API_VERSION || '2025-01';

const GET_PRODUCTS = `
query GetProducts($first: Int = 12) {
  products(first: $first) {
    edges {
      node {
        id
        handle
        title
        description
        images(first: 3) { edges { node { url altText } } }
        variants(first: 5) {
          edges { node { id title availableForSale priceV2 { amount currencyCode } sku } }
        }
      }
    }
  }
}`;

let products = [];

if (SHOP && TOKEN) {
  const response = await fetch(`https://${SHOP}/api/${API_VER}/graphql.json`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-Shopify-Storefront-Access-Token': TOKEN,
    },
    body: JSON.stringify({ query: GET_PRODUCTS, variables: { first: 24 } }),
  });

  const json = await response.json();
  products = json.data?.products?.edges?.map((edge) => edge.node) ?? [];
}
---

<MainLayout title="JNW Wine — Premium Cellar">
  <main>
    <section class="hero-gradient border-b border-amber-300/30 px-5 pb-20 pt-8 md:px-10">
      <header class="mx-auto flex w-full max-w-7xl items-center justify-between border-b border-amber-100/20 pb-5">
        <span class="font-sans text-xs uppercase tracking-[0.35em] text-amber-100/70">JNW</span>
        <nav class="font-sans text-xs uppercase tracking-[0.2em] text-amber-100/65">
          <a class="mr-5" href="#collection">Collection</a>
          <a href="#about">Legacy</a>
        </nav>
      </header>

      <div class="mx-auto mt-12 grid w-full max-w-7xl gap-10 md:grid-cols-[minmax(0,1fr)_300px] md:items-end">
        <div>
          <p class="font-sans text-xs uppercase tracking-[0.4em] text-amber-200/70">A modern private cellar</p>
          <h1 class="mt-4 max-w-2xl text-5xl leading-[0.95] text-amber-50 md:text-7xl">JNW Reserve Collection</h1>
          <p class="mt-6 max-w-xl font-sans text-sm leading-relaxed text-amber-100/80">
            Curated bottles, crafted for memorable tables. Shop by case, explore small-batch labels, and check out in seconds.
          </p>
          <a
            href="#collection"
            class="mt-7 inline-block bg-amber-300 px-7 py-3 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-black"
          >
            Shop the collection
          </a>
        </div>
        <div class="gold-outline rounded-md bg-black/45 p-5">
          <p class="font-sans text-xs uppercase tracking-[0.35em] text-amber-100/70">This week</p>
          <p class="mt-3 text-3xl leading-none text-amber-50">Free shipping</p>
          <p class="mt-3 font-sans text-sm text-amber-100/80">Orders over R1200 include insured nationwide delivery.</p>
        </div>
      </div>
    </section>

    <section id="collection" class="mx-auto w-full max-w-7xl px-5 py-10 md:px-10">
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="text-4xl text-amber-50">Best Sellers</h2>
        <p class="font-sans text-xs uppercase tracking-[0.3em] text-amber-100/60">Black + Gold Edition</p>
      </div>
      {products.length ? (
        <ProductList products={products} />
      ) : (
        <div class="gold-outline rounded-md bg-zinc-950 p-6 font-sans text-sm text-amber-100/80">
          Add Shopify credentials to <code>.env</code> to load products.
        </div>
      )}
    </section>

    <footer id="about" class="border-t border-amber-300/20 px-5 py-10 md:px-10">
      <div class="mx-auto w-full max-w-7xl">
        <p class="font-sans text-xs uppercase tracking-[0.35em] text-amber-100/70">Legacy in every bottle</p>
        <p class="mt-4 max-w-3xl font-sans text-sm leading-relaxed text-amber-100/80">
          JNW pairs classic craftsmanship with a refined digital experience built for modern buyers and bulk order clients.
        </p>
      </div>
    </footer>
  </main>
</MainLayout>
